# Shikshak AI — Backend environment variables
# Copy this file to .env and fill in per 02-TRD.md

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── LLM providers ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Hugging Face ZeroGPU (optional, only for wan_zerogpu video provider) ───────
HF_TOKEN=

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Video provider factory ─────────────────────────────────────────────────────
VIDEO_PROVIDER=manim

# ── TTS / avatar assets ────────────────────────────────────────────────────────
XTTS_MODEL_PATH=./models/xtts_v2
TEACHER_REFERENCE_IMAGE=./assets/teacher_ref.png
TEACHER_REFERENCE_VOICE=./assets/teacher_voice.wav
