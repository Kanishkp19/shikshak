# Shikshak AI — Frontend environment variables
# Copy this file to .env.local and fill in per 02-TRD.md

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Backend API ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Local-dev placeholder student id ───────────────────────────────────────────
# When Supabase Auth isn't wired up yet, set this to the seed profile id
# (00000000-0000-0000-0000-000000000001 from supabase/migrations/011_seed_data.sql)
# so you can click through the demo.
NEXT_PUBLIC_STUDENT_ID=00000000-0000-0000-0000-000000000001
