{
  "ecc-middleware-gateway": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/ecc-gateway.js pre-invocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/ecc-gateway.js pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
